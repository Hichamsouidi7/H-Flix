{
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wasm/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|wasm/|avatars/|live/|platforms/|help/|WatchpartyTutorial/|robots\\.txt|sitemap\\.xml|sw\\.js|movix\\.png|movix512\\.png|thumbnail\\.png|llms\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
